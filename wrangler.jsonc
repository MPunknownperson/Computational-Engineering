{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "computational-engineering",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01", 
  // nodejs_compat gives the Worker the Node built-ins (node:path, node:fs
  // readers, streams, crypto) the app's server code relies on.
  "compatibility_flags": [
    "nodejs_compat", 
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "quilloryn.com", "custom_domain": true },
    { "pattern": "www.quilloryn.com", "custom_domain": true }
  ],
  "minify": false,
  "unsafe": {
    "cap_esbuild_plugins": true
  }
}
