{
  "$schema": "node_modules/wrangler/config-schema.json",
  // wrangler.jsonc
"name": "computational-engineering",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-23",
  // nodejs_compat gives the Worker the Node built-ins (node:path, node:fs
  // readers, streams, crypto) the app's server code relies on.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "quilloryn.com", "custom_domain": true },
    { "pattern": "www.quilloryn.com", "custom_domain": true }
  ]
  // No database bindings: the site is stateless and keeps its working data in
  // the isolate (see src/lib/store). Nothing here needs Hyperdrive or D1.
}
